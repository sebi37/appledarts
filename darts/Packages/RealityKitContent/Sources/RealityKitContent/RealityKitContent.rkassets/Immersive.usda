#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["Material", "Dartboard"]
    def "Dartboard" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            float3 rotationEulerHint = (1.5707964, 0, 3.1415927)
        }
        references = @Untitled.usdc@
    )
    {
        reorder nameChildren = ["_11721_darboard_V4_L3", "env_light", "Material"]
        rel material:binding = </Root/Dartboard/Material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        quatf xformOp:orient = (-3.090862e-8, -3.090862e-8, 0.70710677, 0.70710677)
        float3 xformOp:scale = (0.1, 0.1, 0.1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "_11721_darboard_V4_L3" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            reorder nameChildren = ["_11721_darboard_V4_L3_005", "Material"]
            rel material:binding = None (
                bindMaterialAs = "weakerThanDescendants"
            )

            over "_11721_darboard_V4_L3_005" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                customData = {
                    dictionary RE = {
                        dictionary mesh = {
                            dictionary v1 = {
                                bool reorderVertexCaching = 0
                            }
                        }
                    }
                    float3 rotationEulerHint = (0, 3.1415927, 0)
                }
            )
            {
                rel material:binding = </Root/Dartboard/Material> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                quatf xformOp:orient = (-4.371139e-8, 0, 1, 0)
                float3 xformOp:scale = (0.1, 0.1, 0.1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }

        def Material "Material"
        {
            token outputs:mtlx:surface.connect = </Root/Dartboard/Material/PreviewSurface.outputs:out>
            token outputs:realitykit:vertex
            float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (335.25, 100.5)

            def Shader "PreviewSurface"
            {
                uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
                color3f inputs:diffuseColor.connect = </Root/Dartboard/Material/Image.outputs:out>
                float inputs:roughness
                token outputs:out
                float2 ui:nodegraph:node:pos = (93.5, 100.5)
            }

            def Shader "Image"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @textures/dartboard.jpg@
                color3f outputs:out
                float2 ui:nodegraph:node:pos = (-183.07635, 76.67257)
                int ui:nodegraph:node:stackingOrder = 25
            }
        }
    }
}

