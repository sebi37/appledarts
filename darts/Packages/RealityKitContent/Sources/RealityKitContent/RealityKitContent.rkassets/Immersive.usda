#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["GridMaterial", "Dartboard", "Material"]
    def "Dartboard" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            float3 rotationEulerHint = (1.5707964, 0, 3.1415927)
        }
        references = @Untitled.usdc@
    )
    {
        reorder nameChildren = ["SegmentModel", "_11721_darboard_V4_L3", "env_light"]
        rel material:binding = </Root/Material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        quatf xformOp:orient = (-3.090862e-8, -3.090862e-8, 0.70710677, 0.70710677)
        float3 xformOp:scale = (0.1, 0.1, 0.1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "_11721_darboard_V4_L3" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = None (
                bindMaterialAs = "weakerThanDescendants"
            )

            over "_11721_darboard_V4_L3_005" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                customData = {
                    float3 rotationEulerHint = (0, 3.1415927, 0)
                }
            )
            {
                rel material:binding = </Root/Material> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                quatf xformOp:orient = (-4.371139e-8, 0, 1, 0)
                float3 xformOp:scale = (0.1, 0.1, 0.1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }

        def "SegmentModel" (
            active = true
            customData = {
                float3 rotationEulerHint = (1.5707973, -0.0069813174, -4.656726e-10)
            }
            prepend references = @SegmentModel.usdz@
        )
        {
            quatf xformOp:orient = (0.7071021, 0.70710284, -0.0024682623, 0.0024682644)
            float3 xformOp:scale = (0.118, 0.118, 0.118)
            float3 xformOp:translate = (0.0009809601, 0.08618945, 0.024740357)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "XID_SteelSatin_012510004ACCDE567687595EEACF9B7F"
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex

                over "XID_SteelSatin_012510004ACCDE567687595EEACF9B7F_shader"
                {
                    color3f inputs:diffuseColor = (0.81306547, 0.045177314, 0) (
                        colorSpace = "srgb_displayp3"
                    )
                    float inputs:opacity = 0
                    float inputs:opacityThreshold = 0
                }
            }

            over "Körper1"
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                float3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }

    def Material "Material"
    {
        prepend token outputs:mtlx:surface.connect = </Root/Material/PreviewSurface.outputs:out>
        token outputs:realitykit:vertex
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (335.25, 100.5)

        def Shader "PreviewSurface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor.connect = </Root/Material/Image.outputs:out>
            float inputs:roughness
            token outputs:out
            float2 ui:nodegraph:node:pos = (93.5, 100.5)
        }

        def Shader "Image"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @textures/dartboard.jpg@
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (-183.07635, 76.67257)
            int ui:nodegraph:node:stackingOrder = 25
        }
    }
}

